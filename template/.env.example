# Copy to .env and fill in from your Supabase project (Dashboard → Project Settings → API).
# These are PUBLIC configuration, not secrets — the publishable key is designed to be
# shipped in the client and is governed by Row Level Security.
#
# NEVER put the secret key (sb_secret_… / service_role) here or anywhere in this repo.
# Third-party secrets belong in Supabase Edge Function env (`supabase secrets set`).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
